# Apache-Konfiguration (optional, greift nur auf Apache-Hosting)
Options -Indexes

# Interne Dateien nie ausliefern
<IfModule mod_authz_core.c>
  <FilesMatch "(\.md$|^package(-lock)?\.json$|^\.gitignore$|^\.git|^\.env)">
    Require all denied
  </FilesMatch>
</IfModule>
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/ld+json image/svg+xml
</IfModule>

# WebP automatisch ausliefern, wenn der Browser es unterstützt und eine .webp-Datei existiert (gilt auch für -400w/-800w/-1200w/-960w/-96)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(tools|archive|node_modules|\.git)(/|$) - [F,L]
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
  RewriteRule ^(.+)\.jpe?g$ $1.webp [T=image/webp,L]

  # Alte WordPress-Adressen -> neue Seiten (SEO-Weiterleitungen)
  RewriteRule ^home/unsere-schule/?$ /unsere-schule.html [R=301,L]
  RewriteRule ^allgemeine-infos.*$ /unsere-schule.html [R=301,L]
  RewriteRule ^kollegium/?$ /team.html [R=301,L]
  RewriteRule ^unsere-klassen/?$ /klassen.html [R=301,L]
  RewriteRule ^schulalltag/?$ /schulalltag.html [R=301,L]
  RewriteRule ^unterrichtszeiten/?$ /unterrichtszeiten.html [R=301,L]
  RewriteRule ^aktuelles/?$ /aktuelles.html [R=301,L]
  RewriteRule ^eltern/?$ /eltern.html [R=301,L]
  RewriteRule ^einschulung/?$ /eltern.html#einschulung [NE,R=301,L]
  RewriteRule ^mitteilungen/?$ /mitteilungen.html [R=301,L]
  RewriteRule ^kontakt/?$ /kontakt.html [R=301,L]
  RewriteRule ^datenschutzerklaerung/?$ /datenschutz.html [R=301,L]
  RewriteRule ^elementor-360/?$ /impressum.html [R=301,L]
</IfModule>

# Caching: HTML/JSON/XML revalidieren (ETag, bfcache-tauglich), versionierte CSS/JS und Fonts dauerhaft, Bilder 30 Tage
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # CSS/JS: mit ?v=<Build-ID> ein Jahr (immutable), sonst eine Woche
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
    <If "%{QUERY_STRING} =~ /(^|&)v=/">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|webp|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|webp)$">
    Header append Vary Accept
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Fallback ohne mod_headers
<IfModule !mod_headers.c>
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css   "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/html  "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
  </IfModule>
</IfModule>

# HTTPS erzwingen (nach Einrichtung des Zertifikats aktivieren)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
